<div class="projects_about">
  {% if site.projects_about != blank %}
    {% assign projects_about_size = site.projects_about | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and projects_about_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign projects_about = site.projects_about | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign projects_about_limit = site.announcements.limit %}
        {% else %}
          {% assign projects_about_limit = projects_about_size %}
        {% endif %}
        {% for item in projects_about limit: projects_about_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="projects_about-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No projects_about so far...</p>
  {% endif %}
</div>
