<div class="volunteer">
  {% if site.volunteer != blank %}
    {% assign volunteer_size = site.volunteer | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and volunteer_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign volunteer = site.volunteer | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign volunteer_limit = site.announcements.limit %}
        {% else %}
          {% assign volunteer_limit = volunteer_size %}
        {% endif %}
        {% for item in volunteer limit: volunteer_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="volunteer-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No volunteer so far...</p>
  {% endif %}
</div>
