<div class="competitions">
  {% if site.competitions != blank %}
    {% assign competitions_size = site.competitions | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and competitions_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign competitions = site.competitions | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign competitions_limit = site.announcements.limit %}
        {% else %}
          {% assign competitions_limit = competitions_size %}
        {% endif %}
        {% for item in competitions limit: competitions_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="competitions-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No competitions so far...</p>
  {% endif %}
</div>
