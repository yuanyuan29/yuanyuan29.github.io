<div class="work">
  {% if site.work != blank %}
    {% assign work_size = site.work | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and work_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign work = site.work | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign work_limit = site.announcements.limit %}
        {% else %}
          {% assign work_limit = work_size %}
        {% endif %}
        {% for item in work limit: work_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="work-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No work so far...</p>
  {% endif %}
</div>
